# Postgres. Neon kullanıyorsan (öneri):
#   DATABASE_URL = "pooled" bağlantı (host içinde -pooler geçer) → uygulama çalışırken
#   DIRECT_URL   = "direct" (havuzsuz) bağlantı → migration + seed için
# Pooler yoksa ikisine de aynı "direct" dizeyi yazabilirsin.
DATABASE_URL="postgresql://user:pass@localhost:5432/zerdemkartal"
DIRECT_URL="postgresql://user:pass@localhost:5432/zerdemkartal"

# Admin JWT imzası
JWT_SECRET="degistir-uzun-rastgele-dizi"

# ————— LİSANS SUNUCUSU v1 (varsayılan kapalı) —————
# Migration + dry-run + imzalı istemci pilotu bitmeden 1 yapma.
LICENSE_V1_ENABLED="0"
# Ayrı çevrimiçi Ed25519 PKCS8 PEM anahtarının base64 hali; çevrimdışı
# lisans üretim anahtarı BURAYA KONMAZ. Yalnız Vercel ortam sırrında tutulur.
LICENSE_STATUS_PRIVATE_KEY_B64=""
LICENSE_STATUS_KEY_VERSION="1"
# İzleme pilotu tamamlanmadan yaptırım açılmaz. Şu an bilgilendirme anahtarıdır;
# gerçek yaptırım License.monitoringOnly=false kaydıyla da açıkça onaylanır.
LICENSE_V1_ENFORCEMENT="0"
# TOTP sırlarını Neon'da AES-256-GCM ile şifreleyen ayrı 32 baytlık base64 anahtar.
# JWT ve iki Ed25519 anahtarından farklı olmalı; yalnız sunucu ortam sırrında tutulur.
LICENSE_MFA_ENCRYPTION_KEY_B64=""
# Lisans panelinde parola girişini kapatıp yalnız Google → Authenticator akışını açar.
LICENSE_GOOGLE_ONLY="0"
# Yalnız bu Gmail, Google kimliği doğrulandıktan sonra sahip hesabına bağlanabilir.
LICENSE_GOOGLE_OWNER_EMAIL=""
# Migration sonrasında yalnız ilk sahip hesabını açıkça hazırlayan yerel komut için.
LICENSE_OWNER_EMAIL=""
LICENSE_OWNER_CONFIRM=""

# MCP / servis erişimi için uzun ömürlü token (Faz 3) — JWT'den AYRI tut
ADMIN_TOKEN="degistir-mcp-icin-uzun-token"

# İlk admin kullanıcısı (seed bunu yazar)
ADMIN_EMAIL="merhaba@zerdemkartal.com"
ADMIN_PASSWORD="degistir"

# Yalnız Posta Merkezi hesabı oluşturma/güncelleme sırasında kullanılır.
# Parola kaynakta veya Vercel'de tutulmaz; Neon'a yalnız bcrypt özeti yazılır.
MAIL_OPERATOR_EMAIL="info@hermesastroloji.com"
MAIL_OPERATOR_PASSWORD=""

# Google girişi (üretim) — id_token sunucuda resmî Google kütüphanesiyle doğrulanır.
# Aynı Web istemci kimliği site üye girişi ve sahip lisans panelinde kullanılabilir.
GOOGLE_CLIENT_ID=""

# Site kökü (canonical/OG mutlak URL'ler)
SITE_URL="https://hermesastroloji.com"

# IndexNow anahtarı (opsiyonel — boşsa ping atlanır). Rastgele 32+ karakter hex önerilir;
# anahtar dosyası /indexnow.txt route'undan otomatik servis edilir.
INDEXNOW_KEY=""

# Masaüstü sürüm yayınları için GitHub reposu (opsiyonel — varsayılan: zerdemkartal/hermes-yayin).
# /indir sayfası buradaki son release'ten sürüm no + notları çeker.
RELEASES_REPO="zerdemkartal/hermes-yayin"

# ————— ESKİ ÖDEME: iyzico (yeni başlangıç ucu 410 ile kapalı) —————
# Yalnız geçmiş işlem uyumluluğu için korunur; yeni anahtar eklemeyin.
IYZICO_API_KEY=""
IYZICO_SECRET=""
# Sandbox: https://sandbox-api.iyzipay.com  ·  Canlı: https://api.iyzipay.com
IYZICO_URI="https://sandbox-api.iyzipay.com"

# ————— ÖDEME: PayTR Link API (gizlilik odaklı canlı akış) —————
# Değerleri yalnız Vercel Environment Variables bölümüne ekleyin; kaynak koda yazmayın.
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# Kartlı ödemede PayTR sayfasında gösterilecek en yüksek taksit (1-12).
PAYTR_MAX_INSTALLMENT="12"
# Entegrasyon testi sırasında 1; canlı onaydan sonra 0.
PAYTR_DEBUG="1"
# Normalde 0. Sözleşmenizde orana ek sabit bir güvenlik payı varsa yüzde olarak yazılır.
PAYTR_PRICE_BUFFER_PERCENT="0"
# Oran servisi ilk kez erişilemezse ödeme başlatmak yerine kapalı kalması için boş bırakın.
# Yalnız PayTR panelindeki güncel tek çekim oranını geçici yedek olarak yazabilirsiniz.
PAYTR_SINGLE_RATIO_FALLBACK=""

# ————— E-POSTA: Resend (H2) —————
# RESEND_API_KEY boşken e-posta sessizce atlanır (ödeme/callback akışı kırılmaz).
RESEND_API_KEY=""
# Gönderen — domaini Resend'de doğrulanmış olmalı. Test için "Hermes <onboarding@resend.dev>" kullanılabilir.
EMAIL_FROM="Hermes Astroloji <info@hermesastroloji.com>"
# Yeni müşteri masaüstü girişinin mevcut çevrimdışı Kripto Yönetim kuyruğuna
# düşmesini sağlayan Apps Script URL'si. Boşsa paketlenmiş mevcut köprü kullanılır.
LICENSE_REQUEST_BRIDGE_URL=""
# Resend → Webhooks → email.received için imza sırrı (whsec_...).
RESEND_WEBHOOK_SECRET=""
# Posta Merkezi'nde kullanılabilecek kurumsal adresler. İlk adres varsayılan gönderendir.
MAILBOX_ADDRESSES="info@hermesastroloji.com"
MAILBOX_FROM_NAME="Hermes Astroloji"
# Virgülle ayrılmış tam adres veya @alanadi kalıpları. Bu göndericiler doğrudan Spam'e alınır.
MAIL_SPAM_BLOCKLIST=""
