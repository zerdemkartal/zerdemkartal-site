// zerdemkartal Faz 2 — veri modeli (localStorage zk_* → tablolar)
// Kaynak katalog: prototip zk-data.js › REGISTRY + devir paketi README "Veri modeli"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql" // SQLite ile başlamak için: "sqlite"
  url       = env("DATABASE_URL") // pooled (Neon -pooler) — uygulama çalışırken
  directUrl = env("DIRECT_URL") // direct/havuzsuz — migration + seed için
}

// zk_anasayfa / zk_danismanlik / zk_programlar / zk_pd_astropen / zk_pd_hermes /
// zk_astroloji101 / zk_harita / zk_hakkimda → tek tablo, key'li JSON blob.
// Blob şeması her View'ın Component.DEFAULT/DEF()'i ile tanımlı (devir paketi).
model PageContent {
  key       String   @id // "anasayfa" | "danismanlik" | ...
  data      Json
  updatedAt DateTime @updatedAt
}

// zk_blog_tree → düz tablo (ağaç parentId+order ile kurulur; API ağacı derleyip döner)
model BlogNode {
  id        String   @id // prototipteki node id'leri korunur (p-*, f-*)
  type      String // "folder" | "page"
  title     String
  parentId  String?
  order     Int      @default(0)
  glyph     String?
  // page alanları
  body      String? // WYSIWYG HTML
  md        String? // Markdown kaynağı (varsa)
  excerpt   String?
  date      String? // "YYYY-MM-DD" (prototip formatı korunur)
  seoTitle  String?
  seoDesc   String?
  status    String   @default("published") // "published" | "draft"
  coverId   String? // Asset.id
  updatedAt DateTime @updatedAt
}

// zk_blog_showcase → tek satır config
model BlogShowcase {
  id   Int  @id @default(1)
  data Json // { mode: "auto" | "manual", ids: [], interval: n }
}

// zk_admin_settings → tek satır
model Setting {
  id   Int  @id @default(1)
  data Json // { accent, instagram, youtube, email }
}

// zk_admin_talep → talepler / ön siparişler / iletişim
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  type      String // "Doğum Haritası" | "... (ön sipariş)" | "İletişim · <konu>" | ...
  message   String?
  note      String? // panel notu
  status    String   @default("new") // "new" | "progress" | "done"
  rvDate    String? // randevu talebi: "YYYY-MM-DD" (slot maskeleme bu ikiliyle yapılır)
  rvTime    String? // "HH:MM"
  createdAt DateTime @default(now())
}

// zk_siparis → Hermes lisans siparişleri (Faz 2.5 prototipte mock ödeme; canlıda iyzico/PayTR)
model Order {
  id                 String                     @id @default(cuid())
  name               String
  email              String
  product            String                     @default("Hermes")
  price              Int // TRY, tam sayı (ör. 3000)
  license            String?                    @unique // Ödeme sonrası ayrılan müşteri/lisans numarası; çevrimdışı anahtarda aynen kullanılır.
  status             String                     @default("pending") // pending | paid | delivered | cancelled
  deviceLimit        Int                        @default(1) // 1 cihaz standart; 2 cihaz seçeneği ayrı fiyatlandırılır
  payProvider        String? // "iyzico" | "paytr" | "mock"
  payRef             String? // PSP referansı
  paidAt             DateTime?
  paymentEmailSentAt DateTime?
  createdAt          DateTime                   @default(now())
  requests           LicenseRequest[]
  customerAccess     CustomerLicenseCredential?
  downloadInvites    DownloadInvite[]
}

// PayTR Link başarılı ödeme bildirimi. Mutabakat için gereken işlem özeti
// dışında fatura, telefon, adres, IP veya kart verisi saklanmaz. Müşteri adı ve
// teslim e-postası yalnız ilişkili PaytrCheckout kaydında tutulur.
model PaymentReceipt {
  id                 String         @id @default(cuid())
  provider           String         @default("paytr_link")
  merchantOid        String         @unique
  callbackId         String
  planId             String
  termsVersion       String
  deviceLimit        Int
  netTargetKurus     Int
  paymentAmountKurus Int
  totalAmountKurus   Int
  paymentType        String
  currency           String
  status             String         @default("paid")
  testMode           Boolean        @default(false)
  paidAt             DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  checkout           PaytrCheckout?

  @@index([status, paidAt])
}

// Kartlı satın alma başlamadan önce teslim için gerekli en az müşteri bilgisini
// callback kimliğine bağlar. Kart/fatura/adres/telefon verisi bu tabloda tutulmaz.
model PaytrCheckout {
  id                 String          @id @default(cuid())
  requestId          String          @unique @db.Uuid
  callbackId         String          @unique @db.VarChar(64)
  name               String
  email              String
  planId             String
  termsVersion       String
  deviceLimit        Int
  netTargetKurus     Int
  paymentAmountKurus Int
  status             String          @default("pending")
  merchantOid        String?         @unique
  paymentReceipt     PaymentReceipt? @relation(fields: [paymentReceiptId], references: [id], onDelete: SetNull)
  paymentReceiptId   String?         @unique
  downloadInvite     DownloadInvite? @relation(fields: [downloadInviteId], references: [id], onDelete: SetNull)
  downloadInviteId   String?         @unique
  paymentPageUrl     String?         @db.VarChar(500)
  linkId             String?         @db.VarChar(128)
  expiresAt          DateTime
  paidAt             DateTime?
  deliveryStatus     String          @default("pending")
  deliveryAttempts   Int             @default(0)
  deliverySentAt     DateTime?
  deliveryError      String?         @db.VarChar(64)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([email, createdAt])
  @@index([status, expiresAt])
  @@index([deliveryStatus, updatedAt])
}

// Müşterinin indirme/ilk etkinleştirme hesabı. Parola ve tek kullanımlık kurulum kodu
// hiçbir zaman düz metin tutulmaz; yalnız bcrypt/SHA-256 özetleri saklanır.
model CustomerLicenseCredential {
  id                         String                   @id @default(cuid())
  order                      Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId                    String                   @unique
  licenseNo                  String                   @unique
  application                String                   @default("hermes")
  email                      String
  passwordHash               String?
  passwordTemporary          Boolean                  @default(false)
  temporaryPasswordExpiresAt DateTime?
  setupTokenHash             String?                  @unique @db.Char(64)
  setupExpiresAt             DateTime?
  setupUsedAt                DateTime?
  failedAttempts             Int                      @default(0)
  lockedUntil                DateTime?
  authVersion                Int                      @default(1)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  sessions                   CustomerLicenseSession[]

  @@index([email])
  @@index([application, licenseNo])
}

// Site indirme oturumu kısa ömürlü ve iptal edilebilir; tarayıcıya yalnız rastgele
// ham değer gider, Neon'da bunun SHA-256 özeti bulunur.
model CustomerLicenseSession {
  id           String                    @id @default(cuid())
  credential   CustomerLicenseCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  credentialId String
  tokenHash    String                    @unique @db.Char(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime                  @default(now())

  @@index([credentialId, expiresAt])
  @@index([expiresAt])
}

// Satın alma kaydı olsun veya olmasın yönetim panelinden gönderilebilen, kısa
// ömürlü indirme daveti. Bağlantı belirteci ve geçici parola hiçbir zaman düz
// metin tutulmaz; yalnız SHA-256/bcrypt özetleri saklanır.
model DownloadInvite {
  id                String            @id @default(cuid())
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId           String?
  name              String
  email             String
  application       String            @default("hermes")
  linkTokenHash     String            @unique @db.Char(64)
  passwordHash      String
  passwordExpiresAt DateTime
  failedAttempts    Int               @default(0)
  lockedUntil       DateTime?
  openedAt          DateTime?
  sentAt            DateTime?
  revokedAt         DateTime?
  createdByRef      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sessions          DownloadSession[]
  paytrCheckout     PaytrCheckout?

  @@index([email, createdAt])
  @@index([orderId, createdAt])
  @@index([application, revokedAt, passwordExpiresAt])
}

// Başarılı geçici parola doğrulamasından sonra tarayıcıya yalnız rastgele ham
// değer verilir; Neon'da 30 dakikalık oturumun SHA-256 özeti bulunur.
model DownloadSession {
  id        String         @id @default(cuid())
  invite    DownloadInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  inviteId  String
  tokenHash String         @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([inviteId, expiresAt])
  @@index([expiresAt])
}

// Masaüstü "Lisans İste" (lisans.html) istekleri → geliştirici ÇEVRİMDIŞI imzalar (Kripto Yönetim).
// Site İMZALAMAZ; yalnız toplar + ödemeli siparişe (email) bağlar + panel/MCP'de gösterir. (H2)
model LicenseRequest {
  id        String   @id @default(cuid())
  ad        String
  soyad     String
  email     String
  makineId  String
  uygulama  String   @default("hermes")
  status    String   @default("bekliyor") // bekliyor | imzalandi | gonderildi | reddedildi
  note      String?
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([makineId])
}

// zk_uye_hesaplar (+ zk_astroloji101_progress üyeye bağlanır)
model Member {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  passHash String? // Google hesaplarında null
  provider String? // "google" | null
  sub      String? // Google subject
  picture  String?
  birth    String? // "YYYY-MM-DD", isteğe bağlı
  joinedAt DateTime @default(now())
  progress Json? // Astroloji 101 SRS ilerlemesi (boxes/due/streak/badges)
}

// zk_bulten → bülten aboneleri (Faz 4)
model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // "iletisim" | ...
  createdAt DateTime @default(now())
}

// Panel + MCP girişi
model AdminUser {
  id                         String           @id @default(cuid())
  email                      String           @unique
  passHash                   String
  role                       String           @default("admin")
  licenseRole                String?
  licenseActive              Boolean          @default(false)
  licenseMfaEnabled          Boolean          @default(false)
  licenseMfaSecretCipher     String?
  licenseMfaPendingCipher    String?
  licenseMfaPendingExpiresAt DateTime?
  licenseMfaLastCounter      BigInt?
  licenseMfaRecoveryHashes   Json?
  licenseFailedAttempts      Int              @default(0)
  licenseLockedUntil         DateTime?
  licenseLastLoginAt         DateTime?
  licenseAuthVersion         Int              @default(1)
  licenseRoleChangedAt       DateTime?
  licenseGoogleSub           String?          @unique
  licenseSessions            AdminSession[]
  licenseEvents              LicenseEvent[]   @relation("LicenseEventActor")
  licenseImports             LicenseImport[]  @relation("LicenseImportCreator")
  desktopPairings            DesktopPairing[] @relation("DesktopPairingApprover")
}

// image-slot yüklemeleri (base64 → gerçek dosya/URL)
model Asset {
  id        String   @id @default(cuid())
  slotId    String   @unique // prototipteki image-slot id'si (cat-*, ap-*, zkcover-*)
  url       String
  mime      String
  size      Int
  createdAt DateTime @default(now())
}

// Kurumsal Posta Merkezi — taşıma Resend, kalıcı iş akışı Hermes yönetim panelidir.
// folder: inbox | sent | archive | spam | trash. "Gönderilen" ayrıca yanıt içeren konuşmaları da süzer.
model MailThread {
  id                String        @id @default(cuid())
  subject           String
  normalizedSubject String
  participantName   String?
  participantEmail  String?
  mailbox           String
  folder            String        @default("inbox")
  unreadCount       Int           @default(0)
  starred           Boolean       @default(false)
  lastMessageAt     DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  messages          MailMessage[]

  @@index([folder, lastMessageAt])
  @@index([normalizedSubject, participantEmail])
}

model MailMessage {
  id          String     @id @default(cuid())
  thread      MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId    String
  resendId    String?    @unique
  messageId   String?    @unique
  direction   String // inbound | outbound
  fromAddress String
  fromName    String?
  to          Json
  cc          Json
  bcc         Json
  replyTo     Json
  subject     String
  text        String?    @db.Text
  html        String?    @db.Text
  headers     Json
  attachments Json
  status      String     @default("received") // received | sent | failed
  sentBy      String?
  createdAt   DateTime   @default(now())
  readAt      DateTime?

  @@index([threadId, createdAt])
  @@index([direction, createdAt])
}

// Çevrimdışı imzalı anahtarın çevrimiçi durum kaydı. Tam lisans anahtarı tutulmaz;
// değişmez kimlik SHA-256 parmak izidir. signed* alanları azami yetki tavanıdır.
model License {
  id                   String          @id @default(cuid())
  licenseNo            String          @unique
  fingerprint          String          @unique @db.Char(64)
  application          String
  customerRef          String?
  customerEmail        String?
  issuedAt             DateTime
  expiresAt            DateTime?
  status               String          @default("aktif")
  statusReason         String?
  statusChangedAt      DateTime        @default(now())
  suspendedUntil       DateTime?
  signedLevel          String
  signedFeatures       Json
  remoteLevel          String
  remoteFeatures       Json
  authorizationVersion Int             @default(1)
  deviceLimit          Int             @default(1)
  monitoringOnly       Boolean         @default(true)
  permanentlyRevokedAt DateTime?
  sourceImportId       String?
  sourceImport         LicenseImport?  @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  aliases              LicenseAlias[]
  devices              LicenseDevice[]
  events               LicenseEvent[]
  nonces               LicenseNonce[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([application, status])
  @@index([customerEmail])
  @@index([sourceImportId])
}

// Aynı imzalı anahtarın tarihsel defterde birden fazla lisans numarasıyla görünmesi
// kaynak satırı silmeden tek License kimliğine bağlanır.
model LicenseAlias {
  id        String   @id @default(cuid())
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseId String
  licenseNo String   @unique
  sourceRow Int?
  createdAt DateTime @default(now())

  @@index([licenseId])
}

model LicenseDevice {
  id             String        @id @default(cuid())
  license        License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseId      String
  deviceHash     String        @db.Char(64)
  active         Boolean       @default(true)
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  lastVerifiedAt DateTime?
  lastAppVersion String?
  releasedAt     DateTime?
  lease          LicenseLease?

  @@unique([licenseId, deviceHash])
  @@index([licenseId, active])
}

// Her cihaz için yalnız son imzalı izin özeti tutulur; günlük davranış geçmişi biriktirilmez.
model LicenseLease {
  id           String        @id @default(cuid())
  device       LicenseDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId     String        @unique
  status       String
  rights       Json
  serverTime   DateTime
  nextCheckAt  DateTime
  graceUntil   DateTime
  nonceHash    String        @unique @db.Char(64)
  responseHash String        @db.Char(64)
  keyVersion   Int
  updatedAt    DateTime      @updatedAt
}

// Kısa ömürlü yeniden oynatma koruması. Süresi dolan kayıtlar bakım işiyle temizlenir.
model LicenseNonce {
  id         String   @id @default(cuid())
  license    License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseId  String
  nonceHash  String   @unique @db.Char(64)
  deviceHash String   @db.Char(64)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@index([licenseId, deviceHash])
}

// Yönetim ve güvenlik olayları uygulama tarafından update/delete edilmez; migration
// trigger'ı tabloyu veritabanı seviyesinde de append-only yapar.
model LicenseEvent {
  id           String     @id @default(cuid())
  license      License?   @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  licenseId    String?
  actor        AdminUser? @relation("LicenseEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId      String?
  actorRole    String?
  action       String
  outcome      String
  reason       String?
  beforeState  Json?
  afterState   Json?
  requestId    String     @unique
  previousHash String?    @db.Char(64)
  eventHash    String     @unique @db.Char(64)
  createdAt    DateTime   @default(now())

  @@index([licenseId, createdAt])
  @@index([actorId, createdAt])
}

model LicenseImport {
  id          String     @id @default(cuid())
  sourceHash  String     @unique @db.Char(64)
  mode        String     @default("dry-run")
  status      String     @default("hazirlandi")
  summary     Json
  createdBy   AdminUser? @relation("LicenseImportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime   @default(now())
  committedAt DateTime?
  licenses    License[]

  @@index([createdById, createdAt])
}

// Lisans yönetimi için kısa ömürlü, iptal edilebilir ve MFA durumu taşıyan oturum.
model AdminSession {
  id                String    @id @default(cuid())
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId           String
  tokenHash         String    @unique @db.Char(64)
  authVersion       Int
  mfaVerifiedAt     DateTime?
  reauthenticatedAt DateTime?
  expiresAt         DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime  @default(now())
  context           Json?
  createdAt         DateTime  @default(now())

  @@index([adminId, expiresAt])
}

// Kripto Yönetimi masaüstü uygulamasına kısa ömürlü, tek kullanımlık oturum devri.
// Tarayıcıda yalnız onay verilir; eşleştirme sırrı ve yönetim tokeni düz saklanmaz.
model DesktopPairing {
  id           String     @id
  secretHash   String     @unique @db.Char(64)
  approvedBy   AdminUser? @relation("DesktopPairingApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedAt   DateTime?
  claimedAt    DateTime?
  expiresAt    DateTime
  context      Json?
  createdAt    DateTime   @default(now())

  @@index([expiresAt])
  @@index([approvedById, approvedAt])
}

// Özel Blob deposundaki imzalı kurulumların sunucu taraflı yayın manifesti.
// Blob erişim anahtarı değil yalnız özel pathname ve doğrulama özetleri tutulur.
model ReleaseArtifact {
  id          String   @id @default(cuid())
  application String
  platform    String
  version     String
  fileName    String
  blobPath    String   @unique
  sha512      String
  size        BigInt
  active      Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([application, platform, version])
  @@index([application, platform, active, publishedAt])
}
